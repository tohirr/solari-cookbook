# Solari — grab one at console.getsolari.com (promo: STARTER1MO-MKY4BNDK)
SOLARI_API_KEY=slr_live_...

# Model provider for the agent under test AND the judge. Set one (or both and pick with PASSK_PROVIDER).
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# PASSK_PROVIDER=openai     # anthropic | openai | scripted (auto-detected from whichever key is set)
# PASSK_SCRIPT=pass*9,fail  # scripted provider only: behavior per run, cycling

# Optional overrides
# PASSK_MODEL=claude-opus-5   # or gpt-5.6
# PASSK_EFFORT=high
# PASSK_SAFETY=allow       # auto-acknowledge the model's safety checks. ONLY for disposable benches with no route to real systems.
# PASSK_CLASSIFY=0        # skip the LLM failure classification while iterating
# PASSK_CONCURRENCY=2      # Starter plan allows 2 concurrent sandboxes, Pro allows 10
