{
  "name": "passk",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Reliability bench for computer-use agents: fork one Solari desktop snapshot k times, run the same task on every fork, measure pass^k, and classify why runs diverge.",
  "bin": {
    "passk": "./src/cli.ts"
  },
  "exports": {
    "./agent-types": { "types": "./agent-types/index.d.ts" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "passk": "tsx src/cli.ts",
    "prepare-task": "tsx src/cli.ts prepare",
    "run-task": "tsx src/cli.ts run",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "showcase": "tsx scripts/showcase.ts",
    "landing": "tsx scripts/landing.ts",
    "site:build": "npm run showcase && npm run landing",
    "assets": "tsx scripts/assets.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@solarisdk/sdk": "^0.1.2",
    "ajv": "^8.20.0",
    "marked": "^16.4.2",
    "openai": "^7.9.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
