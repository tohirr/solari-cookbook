{
  "name": "passk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reliability bench for computer-use agents: fork one Solari desktop snapshot k times, run the same task on every fork, measure pass^k, and classify why runs diverge.",
  "bin": {
    "passk": "./src/cli.ts"
  },
  "scripts": {
    "passk": "tsx src/cli.ts",
    "prepare-task": "tsx src/cli.ts prepare",
    "run-task": "tsx src/cli.ts run",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "studio:data": "tsx scripts/studio-data.ts",
    "studio:build": "npm run studio:data && vite build --config studio/vite.config.ts",
    "studio:dev": "npm run studio:data && vite --config studio/vite.config.ts",
    "typecheck:studio": "tsc -p studio/app/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@solarisdk/sdk": "^0.1.2",
    "openai": "^7.9.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  }
}
